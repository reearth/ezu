{
  "name": "pencil-sketch",
  "version": "1",
  "tile-size": 512,
  "pad": 24,
  "params": {
    "paper":         { "type": "color",  "default": "#fbf7ec",
                       "description": "Paper color." },
    "graphite":      { "type": "color",  "default": "#2a2a2d",
                       "description": "Water stroke color (hatching + rivers)." },
    "hatch-angle":   { "type": "number", "default": -30, "min": -90, "max": 90,
                       "description": "Water hatching angle, in degrees." },
    "hatch-spacing": { "type": "number", "default": 24, "min": 8, "max": 64,
                       "description": "Water hatching spacing, in px." },
    "grain":         { "type": "number", "default": 0.28, "min": 0, "max": 1,
                       "description": "Paper grain opacity." }
  },
  "functions": {
    "sketchy-line": {
      "description": "Hand-drawn stroke: wobble line features with `wave`, then draw them with a pencil brush.",
      "inputs": {
        "features":        { "kind": "features" },
        "brush":           { "kind": "brush" },
        "color":           { "kind": "scalar" },
        "radius":          { "kind": "scalar", "description": "Stroke radius, px." },
        "opacity":         { "kind": "scalar" },
        "pressure":        { "kind": "scalar", "description": "Brush pressure base." },
        "pressure-jitter": { "kind": "scalar", "default": 0.45 },
        "dtime":           { "kind": "scalar", "default": 0.06 },
        "amplitude":       { "kind": "scalar", "description": "Wobble amplitude, px." },
        "wavelength":      { "kind": "scalar", "description": "Wobble wavelength, px." },
        "noise-amp":       { "kind": "scalar", "description": "Wobble noise amplitude, px." },
        "noise-scale":     { "kind": "scalar", "description": "Wobble noise scale, px." },
        "radius-curve":    { "kind": "scalar", "default": null,
                             "description": "Optional radius stroke curve `[[t, y], ...]`." },
        "opacity-curve":   { "kind": "scalar", "default": null },
        "dtime-curve":     { "kind": "scalar", "default": null }
      },
      "output": "@draw",
      "output-kind": "raster",
      "nodes": {
        "wob":  { "op": "wave", "features": "@features",
                  "amplitude-px": "@amplitude", "wavelength-px": "@wavelength",
                  "noise-amp-px": "@noise-amp", "noise-scale-px": "@noise-scale" },
        "draw": { "op": "line", "features": "@wob", "brush": "@brush",
                  "color": "@color", "radius-px": "@radius",
                  "opacity": "@opacity", "pressure-base": "@pressure",
                  "pressure-jitter": "@pressure-jitter", "dtime": "@dtime",
                  "radius-stroke-curve":  "@radius-curve",
                  "opacity-stroke-curve": "@opacity-curve",
                  "dtime-stroke-curve":   "@dtime-curve" }
      }
    },
    "water-hatch": {
      "description": "Hatched water shading: hatch the polygons at the document's hatch angle/spacing, then sketch the hatch lines.",
      "inputs": {
        "features": { "kind": "features" },
        "brush":    { "kind": "brush" }
      },
      "output": "@strokes",
      "output-kind": "raster",
      "nodes": {
        "geo":     { "op": "hatch", "features": "@features",
                     "angle-deg": "$hatch-angle", "spacing": "$hatch-spacing" },
        "strokes": { "op": "func", "fn": "sketchy-line",
                     "features": "@geo", "brush": "@brush",
                     "color": "$graphite", "radius": 0.95, "opacity": 0.7,
                     "pressure": 0.65, "dtime": 0.055,
                     "amplitude": 0.8, "wavelength": 18.0,
                     "noise-amp": 0.5, "noise-scale": 9.0 }
      }
    }
  },
  "sources": {
    "pencil_hard":  { "type": "brush", "src": "file:brushes/4H_pencil.myb" },
    "pencil_soft":  { "type": "brush", "src": "file:brushes/2B_pencil.myb" },
    "basemap":      { "type": "mvt", "url": "https://papers.reearth.land/protomaps/tilejson.json" }
  },
  "nodes": {
    "paper_base":      { "op": "solid", "color": "$paper" },

    "paper_grain":     { "op": "noise", "type": "value",
                         "scale-px": 1.6, "octaves": 4,
                         "lacunarity": 2.1, "gain": 0.55,
                         "low-color": "#ffffff00",
                         "high-color": "#3a2e1c",
                         "opacity": "$grain", "anchor": "world" },

    "paper_blotches":  { "op": "noise", "type": "perlin",
                         "scale-px": 60.0, "octaves": 3,
                         "lacunarity": 2.0, "gain": 0.5,
                         "low-color": "#ffffff00",
                         "high-color": "#6a5234",
                         "opacity": 0.18, "anchor": "world" },

    "earth_feat":      { "op": "features", "layer": "earth" },
    "earth_fill_raw":  { "op": "fill-solid", "features": "@earth_feat",
                         "fill": "#efe8d6", "fill-alpha": 1.0 },
    "earth_fill":      { "op": "warp", "input": "@earth_fill_raw",
                         "type": "perlin", "scale-px": 28.0,
                         "octaves": 3, "lacunarity": 2.0, "gain": 0.55,
                         "amp-px": 4.5, "anchor": "world" },

    "pencil_hard_b":   { "op": "brush-file", "src": "@pencil_hard" },
    "pencil_soft_b":   { "op": "brush-file", "src": "@pencil_soft" },

    "ocean_feat":      { "op": "features", "layer": "water",
                         "filter-expr": ["==", ["get","kind"], "ocean"] },
    "ocean_hatch":     { "op": "func", "fn": "water-hatch",
                         "features": "@ocean_feat", "brush": "@pencil_soft_b" },

    "inland_feat":     { "op": "features", "layer": "water",
                         "filter-expr": ["all", ["==",["get","kind"],"water"], ["in",["get","kind_detail"],["literal",["lake","basin"]]]] },
    "inland_hatch":    { "op": "func", "fn": "water-hatch",
                         "features": "@inland_feat", "brush": "@pencil_soft_b" },

    "river_feat":      { "op": "features", "layer": "water",
                         "min-zoom-field": "min_zoom",
                         "filter-expr": ["in", ["get","kind"], ["literal", ["river", "canal", "stream"]]] },
    "river_strokes":   { "op": "func", "fn": "sketchy-line",
                         "features": "@river_feat", "brush": "@pencil_soft_b",
                         "color": "$graphite", "radius": 1.1, "opacity": 0.65,
                         "pressure": 0.6, "dtime": 0.06,
                         "amplitude": 1.2, "wavelength": 26.0,
                         "noise-amp": 1.0, "noise-scale": 12.0,
                         "radius-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-curve": [[0.0, -0.3], [0.1, 0.0], [0.9, 0.0], [1.0, -0.4]] },

    "earth_bound":     { "op": "boundary", "features": "@earth_feat" },
    "earth_outline":   { "op": "func", "fn": "sketchy-line",
                         "features": "@earth_bound", "brush": "@pencil_soft_b",
                         "color": "#24201c", "radius": 1.4, "opacity": 0.62,
                         "pressure": 0.6, "pressure-jitter": 0.4, "dtime": 0.05,
                         "amplitude": 0.35, "wavelength": 40.0,
                         "noise-amp": 0.25, "noise-scale": 22.0,
                         "radius-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-curve": [[0.0, -0.3], [0.08, 0.0], [0.92, 0.0], [1.0, -0.4]] },

    "roads_minor_f":   { "op": "features", "layer": "roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 12,
                         "filter-expr": ["==", ["get","kind"], "minor_road"] },
    "roads_minor":     { "op": "func", "fn": "sketchy-line",
                         "features": "@roads_minor_f", "brush": "@pencil_hard_b",
                         "color": "#2c2620", "radius": 0.9, "opacity": 0.7,
                         "pressure": 0.65, "dtime": 0.06,
                         "amplitude": 0.8, "wavelength": 18.0,
                         "noise-amp": 0.5, "noise-scale": 9.0,
                         "radius-curve":  [[0.0, -1.2], [0.12, 0.0], [0.88, 0.0], [1.0, -1.4]],
                         "opacity-curve": [[0.0, -0.3], [0.1, 0.0], [0.9, 0.0], [1.0, -0.4]] },

    "roads_med_f":     { "op": "features", "layer": "roads",
                         "min-zoom-field": "min_zoom",
                         "filter-expr": ["==", ["get","kind"], "medium_road"] },
    "roads_med":       { "op": "func", "fn": "sketchy-line",
                         "features": "@roads_med_f", "brush": "@pencil_soft_b",
                         "color": "#363029", "radius": 1.2, "opacity": 0.35,
                         "pressure": 0.45, "pressure-jitter": 0.5, "dtime": 0.07,
                         "amplitude": 1.0, "wavelength": 22.0,
                         "noise-amp": 0.6, "noise-scale": 11.0,
                         "radius-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-curve": [[0.0, -0.3], [0.08, 0.0], [0.92, 0.0], [1.0, -0.4]] },

    "roads_major_f":   { "op": "features", "layer": "roads",
                         "min-zoom-field": "min_zoom",
                         "filter-expr": ["all", ["==",["get","kind"],"major_road"], ["in",["get","kind_detail"],["literal",["trunk","primary"]]]] },
    "roads_major_r":   { "op": "expr", "expr": ["step", ["zoom"], 1.2, 12, 2.0] },
    "roads_major":     { "op": "func", "fn": "sketchy-line",
                         "features": "@roads_major_f", "brush": "@pencil_soft_b",
                         "color": "#2a241e", "radius": "@roads_major_r", "opacity": 0.5,
                         "pressure": 0.6, "pressure-jitter": 0.4, "dtime": 0.055,
                         "amplitude": 1.4, "wavelength": 26.0,
                         "noise-amp": 0.8, "noise-scale": 13.0,
                         "radius-curve":  [[0.0, -1.6], [0.08, 0.0], [0.92, 0.0], [1.0, -2.0]],
                         "opacity-curve": [[0.0, -0.35], [0.06, 0.0], [0.94, 0.0], [1.0, -0.45]],
                         "dtime-curve":   [[0.0, 2.5], [0.1, 1.0], [0.9, 1.0], [1.0, 3.0]] },

    "roads_path_f":    { "op": "features", "layer": "roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 14,
                         "filter-expr": ["all", ["==",["get","kind"],"path"], ["!", ["in",["get","kind_detail"],["literal",["steps"]]]]] },
    "roads_path":      { "op": "func", "fn": "sketchy-line",
                         "features": "@roads_path_f", "brush": "@pencil_hard_b",
                         "color": "#3a342c", "radius": 0.6, "opacity": 0.5,
                         "pressure": 0.5, "pressure-jitter": 0.55, "dtime": 0.07,
                         "amplitude": 0.7, "wavelength": 16.0,
                         "noise-amp": 0.5, "noise-scale": 8.0,
                         "radius-curve":  [[0.0, -1.2], [0.12, 0.0], [0.88, 0.0], [1.0, -1.4]],
                         "opacity-curve": [[0.0, -0.3], [0.1, 0.0], [0.9, 0.0], [1.0, -0.4]] },

    "roads_sec_f":     { "op": "features", "layer": "roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 12,
                         "filter-expr": ["all", ["==",["get","kind"],"major_road"], ["in",["get","kind_detail"],["literal",["secondary","tertiary","primary_link"]]]] },
    "roads_sec":       { "op": "func", "fn": "sketchy-line",
                         "features": "@roads_sec_f", "brush": "@pencil_soft_b",
                         "color": "#322b24", "radius": 1.5, "opacity": 0.4,
                         "pressure": 0.5, "dtime": 0.06,
                         "amplitude": 1.1, "wavelength": 22.0,
                         "noise-amp": 0.65, "noise-scale": 11.0,
                         "radius-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-curve": [[0.0, -0.3], [0.08, 0.0], [0.92, 0.0], [1.0, -0.4]] },

    "roads_hwy_f":     { "op": "features", "layer": "roads",
                         "min-zoom-field": "min_zoom",
                         "filter-expr": ["==", ["get","kind"], "highway"] },
    "roads_hwy_r":     { "op": "expr", "expr": ["step", ["zoom"], 1.6, 12, 2.7] },
    "roads_hwy":       { "op": "func", "fn": "sketchy-line",
                         "features": "@roads_hwy_f", "brush": "@pencil_soft_b",
                         "color": "#1c1814", "radius": "@roads_hwy_r", "opacity": 0.6,
                         "pressure": 0.7, "pressure-jitter": 0.35, "dtime": 0.05,
                         "amplitude": 1.2, "wavelength": 30.0,
                         "noise-amp": 0.7, "noise-scale": 15.0,
                         "radius-curve":  [[0.0, -1.8], [0.06, 0.0], [0.94, 0.0], [1.0, -2.2]],
                         "opacity-curve": [[0.0, -0.4], [0.05, 0.0], [0.95, 0.0], [1.0, -0.5]],
                         "dtime-curve":   [[0.0, 3.0], [0.08, 1.0], [0.92, 1.0], [1.0, 3.5]] },

    "out": { "op": "stack", "layers": [
               "@paper_base", "@paper_blotches", "@earth_fill",
               "@ocean_hatch", "@inland_hatch", "@river_strokes",
               "@earth_outline",
               "@roads_path", "@roads_minor", "@roads_med", "@roads_sec",
               "@roads_major", "@roads_hwy",
               "@paper_grain"] }
  },
  "output": "@out"
}
