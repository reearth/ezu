{
  "name": "pencil-sketch",
  "version": "1",
  "tile-size": 512,
  "pad": 24,
  "sources": {
    "pencil_hard":  { "type": "brush", "src": "builtin:4H_pencil" },
    "pencil_soft":  { "type": "brush", "src": "builtin:2B_pencil" },
    "basemap":      { "type": "mvt", "url": "https://papers.reearth.land/protomaps/tilejson.json" }
  },
  "nodes": {
    "paper_base":      { "op": "solid", "color": "#fbf7ec" },

    "paper_grain":     { "op": "noise", "type": "value",
                         "scale-px": 1.6, "octaves": 4,
                         "lacunarity": 2.1, "gain": 0.55,
                         "low-color": "#ffffff00",
                         "high-color": "#3a2e1c",
                         "opacity": 0.28, "anchor": "world" },

    "paper_blotches":  { "op": "noise", "type": "perlin",
                         "scale-px": 60.0, "octaves": 3,
                         "lacunarity": 2.0, "gain": 0.5,
                         "low-color": "#ffffff00",
                         "high-color": "#6a5234",
                         "opacity": 0.18, "anchor": "world" },

    "earth_feat":      { "op": "features", "name": "tile.earth" },
    "earth_fill_raw":  { "op": "fill-solid", "features": "@earth_feat",
                         "fill": "#efe8d6", "fill-alpha": 1.0 },
    "earth_fill":      { "op": "warp", "input": "@earth_fill_raw",
                         "type": "perlin", "scale-px": 28.0,
                         "octaves": 3, "lacunarity": 2.0, "gain": 0.55,
                         "amp-px": 4.5, "anchor": "world" },

    "pencil_hard_b":   { "op": "brush-file", "src": "@pencil_hard" },

    "ocean_feat":      { "op": "features", "name": "tile.water",
                         "filter": { "kind": "ocean" } },
    "ocean_hatch_geo": { "op": "hatch", "features": "@ocean_feat",
                         "angle-deg": -30.0, "spacing": 24.0 },
    "ocean_hatch_wob": { "op": "wave", "features": "@ocean_hatch_geo",
                         "amplitude-px": 0.8, "wavelength-px": 18.0,
                         "noise-amp-px": 0.5, "noise-scale-px": 9.0 },
    "ocean_hatch":     { "op": "line", "features": "@ocean_hatch_wob",
                         "brush": "@pencil_soft_b",
                         "color": "#2a2a2d", "radius-px": 0.95,
                         "opacity": 0.7, "pressure-base": 0.65,
                         "pressure-jitter": 0.45, "dtime": 0.055 },

    "inland_feat":     { "op": "features", "name": "tile.water",
                         "filter": { "kind": "water",
                                     "kind_detail": ["lake", "basin"] } },
    "inland_hatch_geo":{ "op": "hatch", "features": "@inland_feat",
                         "angle-deg": -30.0, "spacing": 24.0 },
    "inland_hatch_wob":{ "op": "wave", "features": "@inland_hatch_geo",
                         "amplitude-px": 0.8, "wavelength-px": 18.0,
                         "noise-amp-px": 0.5, "noise-scale-px": 9.0 },
    "inland_hatch":    { "op": "line", "features": "@inland_hatch_wob",
                         "brush": "@pencil_soft_b",
                         "color": "#2a2a2d", "radius-px": 0.95,
                         "opacity": 0.7, "pressure-base": 0.65,
                         "pressure-jitter": 0.45, "dtime": 0.055 },

    "river_feat":      { "op": "features", "name": "tile.water",
                         "min-zoom-field": "min_zoom",
                         "filter": { "kind": ["river", "canal", "stream"] } },
    "river_wob":       { "op": "wave", "features": "@river_feat",
                         "amplitude-px": 1.2, "wavelength-px": 26.0,
                         "noise-amp-px": 1.0, "noise-scale-px": 12.0 },
    "river_strokes":   { "op": "line", "features": "@river_wob",
                         "brush": "@pencil_soft_b",
                         "color": "#2a2a2d", "radius-px": 1.1,
                         "opacity": 0.65, "pressure-base": 0.6,
                         "pressure-jitter": 0.45, "dtime": 0.06,
                         "radius-stroke-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-stroke-curve": [[0.0, -0.3], [0.1, 0.0], [0.9, 0.0], [1.0, -0.4]] },

    "earth_bound":     { "op": "boundary", "features": "@earth_feat" },
    "earth_bound_wob": { "op": "wave", "features": "@earth_bound",
                         "amplitude-px": 0.35, "wavelength-px": 40.0,
                         "noise-amp-px": 0.25, "noise-scale-px": 22.0 },
    "pencil_soft_b":   { "op": "brush-file", "src": "@pencil_soft" },
    "earth_outline":   { "op": "line", "features": "@earth_bound_wob",
                         "brush": "@pencil_soft_b",
                         "color": "#24201c", "radius-px": 1.4,
                         "opacity": 0.62, "pressure-base": 0.6,
                         "pressure-jitter": 0.4, "dtime": 0.05,
                         "radius-stroke-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-stroke-curve": [[0.0, -0.3], [0.08, 0.0], [0.92, 0.0], [1.0, -0.4]] },

    "roads_minor_f":   { "op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 12,
                         "filter": { "kind": "minor_road" } },
    "roads_minor_w":   { "op": "wave", "features": "@roads_minor_f",
                         "amplitude-px": 0.8, "wavelength-px": 18.0,
                         "noise-amp-px": 0.5, "noise-scale-px": 9.0 },
    "roads_minor":     { "op": "line", "features": "@roads_minor_w",
                         "brush": "@pencil_hard_b",
                         "color": "#2c2620", "radius-px": 0.9,
                         "opacity": 0.7, "pressure-base": 0.65,
                         "pressure-jitter": 0.45, "dtime": 0.06,
                         "radius-stroke-curve":  [[0.0, -1.2], [0.12, 0.0], [0.88, 0.0], [1.0, -1.4]],
                         "opacity-stroke-curve": [[0.0, -0.3], [0.1, 0.0], [0.9, 0.0], [1.0, -0.4]] },

    "roads_med_f":     { "op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom",
                         "filter": { "kind": "medium_road" } },
    "roads_med_w":     { "op": "wave", "features": "@roads_med_f",
                         "amplitude-px": 1.0, "wavelength-px": 22.0,
                         "noise-amp-px": 0.6, "noise-scale-px": 11.0 },
    "roads_med":       { "op": "line", "features": "@roads_med_w",
                         "brush": "@pencil_soft_b",
                         "color": "#363029", "radius-px": 1.2,
                         "opacity": 0.35, "pressure-base": 0.45,
                         "pressure-jitter": 0.5, "dtime": 0.07,
                         "radius-stroke-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-stroke-curve": [[0.0, -0.3], [0.08, 0.0], [0.92, 0.0], [1.0, -0.4]] },

    "roads_major_low_f":{"op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom", "max-zoom": 11,
                         "filter": { "kind": "major_road",
                                     "kind_detail": ["trunk", "primary"] } },
    "roads_major_low_w":{"op": "wave", "features": "@roads_major_low_f",
                         "amplitude-px": 1.4, "wavelength-px": 26.0,
                         "noise-amp-px": 0.8, "noise-scale-px": 13.0 },
    "roads_major_low": { "op": "line", "features": "@roads_major_low_w",
                         "brush": "@pencil_soft_b",
                         "color": "#2a241e", "radius-px": 1.2,
                         "opacity": 0.5, "pressure-base": 0.55,
                         "pressure-jitter": 0.45, "dtime": 0.06,
                         "radius-stroke-curve":  [[0.0, -1.6], [0.08, 0.0], [0.92, 0.0], [1.0, -2.0]],
                         "opacity-stroke-curve": [[0.0, -0.35], [0.06, 0.0], [0.94, 0.0], [1.0, -0.45]] },

    "roads_major_f":   { "op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 12,
                         "filter": { "kind": "major_road",
                                     "kind_detail": ["trunk", "primary"] } },
    "roads_major_w":   { "op": "wave", "features": "@roads_major_f",
                         "amplitude-px": 1.4, "wavelength-px": 26.0,
                         "noise-amp-px": 0.8, "noise-scale-px": 13.0 },
    "roads_major":     { "op": "line", "features": "@roads_major_w",
                         "brush": "@pencil_soft_b",
                         "color": "#2a241e", "radius-px": 2.0,
                         "opacity": 0.5, "pressure-base": 0.6,
                         "pressure-jitter": 0.4, "dtime": 0.055,
                         "radius-stroke-curve":  [[0.0, -1.6], [0.08, 0.0], [0.92, 0.0], [1.0, -2.0]],
                         "opacity-stroke-curve": [[0.0, -0.35], [0.06, 0.0], [0.94, 0.0], [1.0, -0.45]],
                         "dtime-stroke-curve":   [[0.0, 2.5], [0.1, 1.0], [0.9, 1.0], [1.0, 3.0]] },

    "roads_path_f":    { "op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 14,
                         "filter": { "kind": "path",
                                     "kind_detail": { "not": ["steps"] } } },
    "roads_path_w":    { "op": "wave", "features": "@roads_path_f",
                         "amplitude-px": 0.7, "wavelength-px": 16.0,
                         "noise-amp-px": 0.5, "noise-scale-px": 8.0 },
    "roads_path":      { "op": "line", "features": "@roads_path_w",
                         "brush": "@pencil_hard_b",
                         "color": "#3a342c", "radius-px": 0.6,
                         "opacity": 0.5, "pressure-base": 0.5,
                         "pressure-jitter": 0.55, "dtime": 0.07,
                         "radius-stroke-curve":  [[0.0, -1.2], [0.12, 0.0], [0.88, 0.0], [1.0, -1.4]],
                         "opacity-stroke-curve": [[0.0, -0.3], [0.1, 0.0], [0.9, 0.0], [1.0, -0.4]] },

    "roads_sec_f":     { "op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 12,
                         "filter": { "kind": "major_road",
                                     "kind_detail": ["secondary", "tertiary", "primary_link"] } },
    "roads_sec_w":     { "op": "wave", "features": "@roads_sec_f",
                         "amplitude-px": 1.1, "wavelength-px": 22.0,
                         "noise-amp-px": 0.65, "noise-scale-px": 11.0 },
    "roads_sec":       { "op": "line", "features": "@roads_sec_w",
                         "brush": "@pencil_soft_b",
                         "color": "#322b24", "radius-px": 1.5,
                         "opacity": 0.4, "pressure-base": 0.5,
                         "pressure-jitter": 0.45, "dtime": 0.06,
                         "radius-stroke-curve":  [[0.0, -1.4], [0.1, 0.0], [0.9, 0.0], [1.0, -1.6]],
                         "opacity-stroke-curve": [[0.0, -0.3], [0.08, 0.0], [0.92, 0.0], [1.0, -0.4]] },

    "roads_hwy_low_f": { "op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom", "max-zoom": 11,
                         "filter": { "kind": "highway" } },
    "roads_hwy_low_w": { "op": "wave", "features": "@roads_hwy_low_f",
                         "amplitude-px": 1.2, "wavelength-px": 30.0,
                         "noise-amp-px": 0.7, "noise-scale-px": 15.0 },
    "roads_hwy_low":   { "op": "line", "features": "@roads_hwy_low_w",
                         "brush": "@pencil_soft_b",
                         "color": "#1c1814", "radius-px": 1.6,
                         "opacity": 0.6, "pressure-base": 0.6,
                         "pressure-jitter": 0.4, "dtime": 0.05,
                         "radius-stroke-curve":  [[0.0, -1.8], [0.06, 0.0], [0.94, 0.0], [1.0, -2.2]],
                         "opacity-stroke-curve": [[0.0, -0.4], [0.05, 0.0], [0.95, 0.0], [1.0, -0.5]],
                         "dtime-stroke-curve":   [[0.0, 3.0], [0.08, 1.0], [0.92, 1.0], [1.0, 3.5]] },

    "roads_hwy_f":     { "op": "features", "name": "tile.roads",
                         "min-zoom-field": "min_zoom", "min-zoom": 12,
                         "filter": { "kind": "highway" } },
    "roads_hwy_w":     { "op": "wave", "features": "@roads_hwy_f",
                         "amplitude-px": 1.2, "wavelength-px": 30.0,
                         "noise-amp-px": 0.7, "noise-scale-px": 15.0 },
    "roads_hwy":       { "op": "line", "features": "@roads_hwy_w",
                         "brush": "@pencil_soft_b",
                         "color": "#1c1814", "radius-px": 2.7,
                         "opacity": 0.6, "pressure-base": 0.7,
                         "pressure-jitter": 0.35, "dtime": 0.05,
                         "radius-stroke-curve":  [[0.0, -1.8], [0.06, 0.0], [0.94, 0.0], [1.0, -2.2]],
                         "opacity-stroke-curve": [[0.0, -0.4], [0.05, 0.0], [0.95, 0.0], [1.0, -0.5]],
                         "dtime-stroke-curve":   [[0.0, 3.0], [0.08, 1.0], [0.92, 1.0], [1.0, 3.5]] },

    "c0": { "op": "blend", "base": "@paper_base",     "over": "@paper_blotches" },
    "c1": { "op": "blend", "base": "@c0",             "over": "@earth_fill" },
    "c2": { "op": "blend", "base": "@c1",             "over": "@ocean_hatch" },
    "c3": { "op": "blend", "base": "@c2",             "over": "@inland_hatch" },
    "c3b":{ "op": "blend", "base": "@c3",             "over": "@river_strokes" },
    "c4": { "op": "blend", "base": "@c3b",            "over": "@earth_outline" },
    "c5": { "op": "blend", "base": "@c4",             "over": "@roads_path" },
    "c5b":{ "op": "blend", "base": "@c5",             "over": "@roads_minor" },
    "c6": { "op": "blend", "base": "@c5b",            "over": "@roads_med" },
    "c6b":{ "op": "blend", "base": "@c6",             "over": "@roads_sec" },
    "c7": { "op": "blend", "base": "@c6b",            "over": "@roads_major" },
    "c7b":{ "op": "blend", "base": "@c7",             "over": "@roads_major_low" },
    "c8": { "op": "blend", "base": "@c7b",            "over": "@roads_hwy" },
    "c8b":{ "op": "blend", "base": "@c8",             "over": "@roads_hwy_low" },
    "out": { "op": "blend", "base": "@c8b",           "over": "@paper_grain" }
  },
  "output": "@out"
}
