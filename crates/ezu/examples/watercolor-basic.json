{
  "name": "watercolor-basic",
  "version": "1",
  "tile-size": 512,
  "pad": 24,
  "assets": {
    "glazing": { "type": "brush", "src": "watercolor_glazing" }
  },
  "nodes": {
    "bg":              { "op": "solid", "color": "#fbf6e6" },

    "earth_feat":      { "op": "mvt-source", "source-layer": "earth" },
    "earth":           { "op": "fill-solid", "features": "@earth_feat",
                         "fill": "#e8d9b0" },

    "landuse_feat":    { "op": "mvt-source", "source-layer": "landuse" },
    "landuse":         { "op": "fill-solid", "features": "@landuse_feat",
                         "fill": "#a6c084", "fill-alpha": 0.7 },

    "water_feat":      { "op": "mvt-source", "source-layer": "water" },
    "water":           { "op": "fill-dabs", "features": "@water_feat",
                         "color": "#5876a0", "opacity": 0.22,
                         "radius-px": 7.0, "hardness": 0.5, "paint": 1.0,
                         "spacing-px": 3.0, "position-jitter": 0.9,
                         "size-jitter": 0.4, "opacity-jitter": 0.3,
                         "value-jitter": 0.08 },

    "glazing_brush":   { "op": "brush-file", "src": "@glazing" },

    "roads_primary_f": { "op": "mvt-source", "source-layer": "roads",
                         "min-zoom-field": "min_zoom",
                         "filter": { "kind_detail": "primary" } },
    "roads_primary":   { "op": "line", "features": "@roads_primary_f",
                         "brush": "@glazing_brush",
                         "color": "#8a6a52", "radius-px": 0.9,
                         "opacity": 0.45, "pressure-base": 0.55,
                         "pressure-jitter": 0.2, "dtime": 0.06 },

    "roads_trunk_f":   { "op": "mvt-source", "source-layer": "roads",
                         "min-zoom-field": "min_zoom",
                         "filter": { "kind_detail": "trunk" } },
    "roads_trunk":     { "op": "line", "features": "@roads_trunk_f",
                         "brush": "@glazing_brush",
                         "color": "#6a4f3a", "radius-px": 1.6,
                         "opacity": 0.6, "pressure-base": 0.7,
                         "pressure-jitter": 0.2, "dtime": 0.05 },

    "roads_motor_f":   { "op": "mvt-source", "source-layer": "roads",
                         "min-zoom-field": "min_zoom",
                         "filter": { "kind_detail": "motorway" } },
    "roads_motor":     { "op": "line", "features": "@roads_motor_f",
                         "brush": "@glazing_brush",
                         "color": "#4a3424", "radius-px": 2.6,
                         "opacity": 0.78, "pressure-base": 0.85,
                         "pressure-jitter": 0.15, "dtime": 0.04 },

    "c1": { "op": "blend", "base": "@bg", "over": "@earth" },
    "c2": { "op": "blend", "base": "@c1", "over": "@landuse" },
    "c3": { "op": "blend", "base": "@c2", "over": "@water" },
    "c4": { "op": "blend", "base": "@c3", "over": "@roads_primary" },
    "c5": { "op": "blend", "base": "@c4", "over": "@roads_trunk" },
    "out": { "op": "blend", "base": "@c5", "over": "@roads_motor" }
  },
  "output": "@out"
}
