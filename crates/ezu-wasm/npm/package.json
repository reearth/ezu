{
  "name": "@reearth/ezu",
  "version": "0.9.0",
  "description": "Painterly map renderer — WebAssembly bindings",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reearth/ezu"
  },
  "homepage": "https://github.com/reearth/ezu",
  "keywords": ["map", "renderer", "wasm", "webassembly", "mvt", "painterly"],
  "type": "module",
  "packageManager": "npm@11.15.0",
  "scripts": {
    "prepublishOnly": "cd ../../.. && bash scripts/build-wasm-npm.sh"
  },
  "exports": {
    ".": {
      "workerd": {
        "types": "./workerd/ezu.d.ts",
        "default": "./workerd/ezu.js"
      },
      "browser": {
        "types": "./web/ezu.d.ts",
        "default": "./web/ezu.js"
      },
      "node": {
        "types": "./nodejs/ezu.d.ts",
        "default": "./nodejs/ezu.js"
      },
      "import": {
        "types": "./bundler/ezu.d.ts",
        "default": "./bundler/ezu.js"
      }
    },
    "./web": {
      "types": "./web/ezu.d.ts",
      "default": "./web/ezu.js"
    },
    "./bundler": {
      "types": "./bundler/ezu.d.ts",
      "default": "./bundler/ezu.js"
    },
    "./nodejs": {
      "types": "./nodejs/ezu.d.ts",
      "default": "./nodejs/ezu.js"
    },
    "./workerd": {
      "types": "./workerd/ezu.d.ts",
      "default": "./workerd/ezu.js"
    },
    "./workerd/ezu.js": "./workerd/ezu.js",
    "./bundler/ezu_bg.js": "./bundler/ezu_bg.js",
    "./bundler/ezu_bg.wasm": "./bundler/ezu_bg.wasm",
    "./web/ezu_bg.wasm": "./web/ezu_bg.wasm",
    "./simd": {
      "workerd": {
        "types": "./simd/workerd/ezu.d.ts",
        "default": "./simd/workerd/ezu.js"
      },
      "browser": {
        "types": "./simd/web/ezu.d.ts",
        "default": "./simd/web/ezu.js"
      },
      "node": {
        "types": "./simd/nodejs/ezu.d.ts",
        "default": "./simd/nodejs/ezu.js"
      },
      "import": {
        "types": "./simd/bundler/ezu.d.ts",
        "default": "./simd/bundler/ezu.js"
      }
    },
    "./simd/web": {
      "types": "./simd/web/ezu.d.ts",
      "default": "./simd/web/ezu.js"
    },
    "./simd/bundler": {
      "types": "./simd/bundler/ezu.d.ts",
      "default": "./simd/bundler/ezu.js"
    },
    "./simd/nodejs": {
      "types": "./simd/nodejs/ezu.d.ts",
      "default": "./simd/nodejs/ezu.js"
    },
    "./simd/workerd": {
      "types": "./simd/workerd/ezu.d.ts",
      "default": "./simd/workerd/ezu.js"
    },
    "./simd/workerd/ezu.js": "./simd/workerd/ezu.js",
    "./simd/bundler/ezu_bg.js": "./simd/bundler/ezu_bg.js",
    "./simd/bundler/ezu_bg.wasm": "./simd/bundler/ezu_bg.wasm",
    "./simd/web/ezu_bg.wasm": "./simd/web/ezu_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "web",
    "bundler",
    "nodejs",
    "workerd",
    "simd",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.wasm",
    "./web/ezu.js",
    "./bundler/ezu.js",
    "./nodejs/ezu.js",
    "./workerd/ezu.js",
    "./simd/web/ezu.js",
    "./simd/bundler/ezu.js",
    "./simd/nodejs/ezu.js",
    "./simd/workerd/ezu.js"
  ]
}
