{
  "name": "figure",
  "tile-size": 512,
  "pad": 48,
  "sources": {
    "basemap": {
      "type": "mvt",
      "url": "https://papers.reearth.land/protomaps/tilejson.json"
    }
  },
  "nodes": {
    "bg": {
      "op": "solid",
      "color": "#faf6ec"
    },
    "base_earth_f": {
      "op": "features",
      "layer": "earth"
    },
    "base_earth": {
      "op": "fill-solid",
      "features": "@base_earth_f",
      "fill": "#ece1c6"
    },
    "base_water_f": {
      "op": "features",
      "layer": "water"
    },
    "base_water": {
      "op": "fill-solid",
      "features": "@base_water_f",
      "fill": "#8fb4d9"
    },
    "base_roads_f": {
      "op": "features",
      "layer": "roads",
      "min-zoom-field": "min_zoom"
    },
    "base_roads": {
      "op": "stroke",
      "features": "@base_roads_f",
      "color": "#b09a80",
      "width-px": 1.2
    },
    "base": {
      "op": "stack",
      "layers": [
        "@bg",
        "@base_earth",
        "@base_water",
        "@base_roads"
      ]
    },
    "tile": {
      "op": "tile-bounds"
    },
    "area": {
      "op": "buffer",
      "features": "@tile",
      "distance": 64
    },
    "bed": {
      "op": "hatch",
      "features": "@area",
      "angle-deg": 0,
      "spacing": 32
    },
    "verticals_a": {
      "op": "hatch",
      "features": "@area",
      "angle-deg": 90,
      "spacing": 72
    },
    "head_a": {
      "op": "dash",
      "features": "@verticals_a",
      "dash-px": 32,
      "gap-px": 32
    },
    "verticals_b": {
      "op": "hatch",
      "features": "@area",
      "angle-deg": 90,
      "spacing": 72,
      "phase": 0.5
    },
    "head_b": {
      "op": "dash",
      "features": "@verticals_b",
      "dash-px": 32,
      "gap-px": 32,
      "phase-px": 32
    },
    "bed_joints": {
      "op": "stroke",
      "features": "@bed",
      "color": "#cfc7b6",
      "width-px": 4
    },
    "head_joints_a": {
      "op": "stroke",
      "features": "@head_a",
      "color": "#cfc7b6",
      "width-px": 4,
      "cap": "square"
    },
    "head_joints_b": {
      "op": "stroke",
      "features": "@head_b",
      "color": "#cfc7b6",
      "width-px": 4,
      "cap": "square"
    },
    "mortar": {
      "op": "stack",
      "layers": [
        "@bed_joints",
        "@head_joints_a",
        "@head_joints_b"
      ]
    },
    "mortar_wobbly": {
      "op": "warp",
      "input": "@mortar",
      "amp-px": 1.5,
      "scale-px": 30,
      "octaves": 2,
      "boundary": "transparent"
    },
    "centres": {
      "op": "point-grid",
      "anchor": "world",
      "spacing": 576,
      "spacing-y": 256,
      "offset-x": 288,
      "offset-y": 128,
      "stagger": 0.5
    },
    "bricks": {
      "op": "voronoi-fracture",
      "features": "@area",
      "seeds": "@centres",
      "aspect": 8
    },
    "fired": {
      "op": "fill-solid",
      "features": "@bricks",
      "fill": "#a4472f",
      "fill-expr": [
        "interpolate",
        [
          "linear"
        ],
        [
          "get",
          "random"
        ],
        0,
        "#86361f",
        1,
        "#bb6040"
      ]
    },
    "mottle": {
      "op": "noise",
      "type": "perlin",
      "scale-px": 140,
      "octaves": 3,
      "low-color": "#000000",
      "high-color": "#ffffff"
    },
    "clay": {
      "op": "blend",
      "base": "@fired",
      "over": "@mottle",
      "mode": "soft-light",
      "opacity": 0.5
    },
    "grain": {
      "op": "noise",
      "type": "perlin",
      "scale-px": 3,
      "octaves": 2,
      "low-color": "#00000055",
      "high-color": "#ffffff40"
    },
    "shadow_line": {
      "op": "stroke",
      "features": "@bed",
      "color": "#000000",
      "width-px": 8
    },
    "shadow": {
      "op": "blur",
      "input": "@shadow_line",
      "sigma": 2.5
    },
    "soot": {
      "op": "noise",
      "type": "perlin",
      "scale-px": 220,
      "octaves": 4,
      "low-color": "#3a2a2000",
      "high-color": "#3a2a20"
    },
    "clay_grain": {
      "op": "blend",
      "base": "@clay",
      "over": "@grain",
      "mode": "overlay"
    },
    "clay_shaded": {
      "op": "blend",
      "base": "@clay_grain",
      "over": "@shadow",
      "mode": "multiply",
      "opacity": 0.35
    },
    "laid": {
      "op": "blend",
      "base": "@clay_shaded",
      "over": "@mortar_wobbly"
    },
    "out": {
      "op": "blend",
      "base": "@base",
      "over": "@brick",
      "mask": "@footprints"
    },
    "brick": {
      "op": "blend",
      "base": "@laid",
      "over": "@soot",
      "mode": "multiply",
      "opacity": 0.45
    },
    "buildings": {
      "op": "features",
      "source": "basemap",
      "layer": "buildings"
    },
    "footprints": {
      "op": "fill-solid",
      "features": "@buildings",
      "fill": "#ffffff"
    }
  },
  "output": "@out"
}
