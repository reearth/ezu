{
  "name": "figure",
  "tile-size": 512,
  "pad": 8,
  "nodes": {
    "area": {
      "op": "tile-bounds",
      "cover": "canvas"
    },
    "seeds": {
      "op": "point-scatter",
      "spacing": 320
    },
    "cells": {
      "op": "voronoi-fracture",
      "features": "@area",
      "seeds": "@seeds"
    },
    "shrunk": {
      "op": "buffer",
      "features": "@cells",
      "distance": -3,
      "join": "round"
    },
    "stones": {
      "op": "smooth",
      "features": "@shrunk",
      "iterations": 3
    },
    "silhouette": {
      "op": "fill-solid",
      "features": "@stones",
      "fill": "#ffffff"
    },
    "rounded": {
      "op": "blur",
      "input": "@silhouette",
      "sigma": 4
    },
    "coverage": {
      "op": "pick-channel",
      "input": "@rounded",
      "channel": "a"
    },
    "height": {
      "op": "map-range",
      "field": "@coverage",
      "out-min": 0,
      "out-max": 6
    },
    "relief": {
      "op": "hillshade",
      "field": "@height",
      "mode": "relief"
    },
    "toned": {
      "op": "fill-solid",
      "features": "@stones",
      "fill": "#9a8f80",
      "fill-expr": [
        "interpolate",
        [
          "linear"
        ],
        [
          "get",
          "random"
        ],
        0,
        "#6e655b",
        1,
        "#c4b8a4"
      ]
    },
    "grain": {
      "op": "noise",
      "type": "perlin",
      "scale-px": 4,
      "octaves": 3,
      "low-color": "#00000050",
      "high-color": "#ffffff40"
    },
    "grained": {
      "op": "blend",
      "base": "@toned",
      "over": "@grain",
      "mode": "overlay",
      "clip": true
    },
    "stones_lit": {
      "op": "blend",
      "base": "@grained",
      "over": "@relief",
      "mode": "multiply",
      "clip": true
    },
    "joints": {
      "op": "solid",
      "color": "#3a3128"
    },
    "out": {
      "op": "stack",
      "layers": [
        "@paper",
        "@stone_shapes",
        "@cell_edges",
        "@seed_dots"
      ]
    },
    "paper": {
      "op": "solid",
      "color": "#fbf6e6"
    },
    "cell_edges": {
      "op": "stroke",
      "features": "@cells",
      "color": "#5c5248",
      "width-px": 1.5
    },
    "stone_shapes": {
      "op": "fill-solid",
      "features": "@stones",
      "fill": "#c9bda8"
    },
    "seed_dots": {
      "op": "circles",
      "features": "@seeds",
      "color": "#c0392b",
      "radius": 3
    }
  },
  "output": "@out"
}
