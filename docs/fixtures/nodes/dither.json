{
  "name": "dither-demo",
  "tile-size": 512,
  "pad": 8,
  "sources": {
    "basemap": {
      "type": "mvt",
      "url": "https://papers.reearth.land/protomaps/tilejson.json"
    }
  },
  "nodes": {
    "base": {
      "op": "stack",
      "layers": [
        "@bg",
        "@base_earth",
        "@base_water",
        "@base_roads"
      ]
    },
    "base_earth": {
      "op": "fill-solid",
      "features": "@base_earth_f",
      "fill": "#ece1c6"
    },
    "base_earth_f": {
      "op": "features",
      "layer": "earth"
    },
    "base_roads": {
      "op": "stroke",
      "features": "@base_roads_f",
      "color": "#b09a80",
      "width-px": 1.2
    },
    "base_roads_f": {
      "op": "features",
      "layer": "roads",
      "min-zoom-field": "min_zoom"
    },
    "base_water": {
      "op": "fill-solid",
      "features": "@base_water_f",
      "fill": "#8fb4d9"
    },
    "base_water_f": {
      "op": "features",
      "layer": "water"
    },
    "bg": {
      "op": "solid",
      "color": "#faf6ec"
    },
    "out": {
      "op": "dither",
      "input": "@base",
      "palette": [
        "#2b2b2b",
        "#e8dcc0",
        "#c0703a",
        "#4a7bb7"
      ],
      "method": "floyd-steinberg",
      "space": "lab"
    }
  },
  "output": "@out"
}
