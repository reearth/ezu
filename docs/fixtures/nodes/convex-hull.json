{
  "name": "convex-hull-demo",
  "tile-size": 512,
  "pad": 8,
  "sources": {
    "basemap": {
      "type": "mvt",
      "url": "https://papers.reearth.land/protomaps/tilejson.json"
    }
  },
  "nodes": {
    "base": {
      "op": "stack",
      "layers": [
        "@bg",
        "@base_earth",
        "@base_water",
        "@base_roads"
      ]
    },
    "base_earth": {
      "op": "fill-solid",
      "features": "@base_earth_f",
      "fill": "#ece1c6"
    },
    "base_earth_f": {
      "op": "features",
      "layer": "earth"
    },
    "base_roads": {
      "op": "stroke",
      "features": "@base_roads_f",
      "color": "#b09a80",
      "width-px": 1.2
    },
    "base_roads_f": {
      "op": "features",
      "layer": "roads",
      "min-zoom-field": "min_zoom"
    },
    "base_water": {
      "op": "fill-solid",
      "features": "@base_water_f",
      "fill": "#8fb4d9"
    },
    "base_water_f": {
      "op": "features",
      "layer": "water"
    },
    "bg": {
      "op": "solid",
      "color": "#faf6ec"
    },
    "c": {
      "op": "transform",
      "features": "@c0",
      "scale": 0.55
    },
    "c0": {
      "op": "centroid",
      "features": "@water_f"
    },
    "dots": {
      "op": "circles",
      "features": "@c",
      "color": "#c2410c",
      "radius": 3
    },
    "h": {
      "op": "convex-hull",
      "features": "@c"
    },
    "hl": {
      "op": "boundary",
      "features": "@h"
    },
    "hull": {
      "op": "stroke",
      "features": "@hl",
      "color": "#c2410c",
      "width-px": 2.5
    },
    "out": {
      "op": "stack",
      "layers": [
        "@base",
        "@dots",
        "@hull"
      ]
    },
    "water_f": {
      "op": "features",
      "layer": "water"
    }
  },
  "output": "@out"
}
