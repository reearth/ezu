{
  "name": "texture-marble",
  "tile-size": 512,
  "pad": 96,
  "nodes": {
    "bands": {
      "op": "noise",
      "type": "perlin",
      "scale-px": [900, 70],
      "octaves": 2,
      "low-color": "#000000",
      "high-color": "#ffffff"
    },
    "warped": {
      "op": "warp",
      "input": "@bands",
      "amp-px": 70,
      "scale-px": 180,
      "octaves": 5
    },
    "lum": { "op": "pick-channel", "input": "@warped", "channel": "luminance" },
    "out": {
      "op": "color-ramp",
      "field": "@lum",
      "space": "lab",
      "stops": [
        { "value": 0.0, "color": "#d9d4c7" },
        { "value": 0.44, "color": "#f3f0e8" },
        { "value": 0.49, "color": "#8a8478" },
        { "value": 0.5, "color": "#4a463f" },
        { "value": 0.51, "color": "#8a8478" },
        { "value": 0.56, "color": "#f3f0e8" },
        { "value": 1.0, "color": "#e4dfd2" }
      ]
    }
  },
  "output": "@out"
}
