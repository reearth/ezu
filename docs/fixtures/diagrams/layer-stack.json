{
  "name": "layer-stack-diagram",
  "tile-size": 512,
  "pad": 8,
  "sources": {
    "basemap": {
      "type": "mvt",
      "url": "https://papers.reearth.land/protomaps/tilejson.json"
    }
  },
  "nodes": {
    "bg": {
      "op": "solid",
      "color": "#faf6ec"
    },
    "earth_f": {
      "op": "features",
      "source": "basemap",
      "layer": "earth"
    },
    "earth": {
      "op": "fill-solid",
      "features": "@earth_f",
      "fill": "#ece1c6"
    },
    "water_f": {
      "op": "features",
      "source": "basemap",
      "layer": "water"
    },
    "water": {
      "op": "fill-solid",
      "features": "@water_f",
      "fill": "#8fb4d9"
    },
    "roads_f": {
      "op": "features",
      "source": "basemap",
      "layer": "roads"
    },
    "roads": {
      "op": "stroke",
      "features": "@roads_f",
      "color": "#b09a80",
      "width-px": 1.2
    },
    "out": {
      "op": "stack",
      "layers": ["@bg", "@earth", "@water", "@roads"]
    }
  },
  "output": "@out"
}
