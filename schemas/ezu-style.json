{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Style",
  "description": "A parsed Ezu Style document.",
  "type": "object",
  "properties": {
    "background": {
      "$ref": "#/$defs/HexColor"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LayerSpec"
      }
    },
    "name": {
      "type": "string"
    },
    "pad": {
      "type": "integer",
      "format": "uint32",
      "default": 0,
      "minimum": 0
    },
    "tile-size": {
      "type": "integer",
      "format": "uint32",
      "default": 512,
      "minimum": 0
    },
    "version": {
      "type": "string",
      "default": "1"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "background",
    "layers"
  ],
  "$defs": {
    "FilterAtom": {
      "description": "Scalar literal used inside a filter clause.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "FilterMatch": {
      "description": "A single filter clause: exact match or membership test.",
      "anyOf": [
        {
          "$ref": "#/$defs/FilterAtom"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilterAtom"
          }
        }
      ]
    },
    "HexColor": {
      "title": "HexColor",
      "description": "sRGB color: `#rrggbb` or `#rrggbbaa`",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "LayerSpec": {
      "description": "One layer in the render pipeline. Discriminated by `type`.",
      "oneOf": [
        {
          "description": "`tiny-skia` solid fill + optional outline + gaussian blur.",
          "type": "object",
          "properties": {
            "blur-sigma": {
              "type": "number",
              "format": "float",
              "default": 0.0
            },
            "edge": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HexColor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "edge-width": {
              "type": "number",
              "format": "float",
              "default": 1.0
            },
            "fill": {
              "$ref": "#/$defs/HexColor"
            },
            "fill-alpha": {
              "type": "number",
              "format": "float",
              "default": 1.0
            },
            "filter": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "$ref": "#/$defs/FilterMatch"
              }
            },
            "id": {
              "type": "string"
            },
            "min-zoom-field": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "source-layer": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "fill-solid"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "source-layer",
            "fill"
          ]
        },
        {
          "description": "`hokusai` scatter-dab fill with world-deterministic jitter.",
          "type": "object",
          "properties": {
            "color": {
              "description": "Color in sRGB hex. Will be converted to linear sRGB for hokusai.",
              "$ref": "#/$defs/HexColor"
            },
            "filter": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "$ref": "#/$defs/FilterMatch"
              }
            },
            "hardness": {
              "type": "number",
              "format": "float",
              "default": 0.5
            },
            "id": {
              "type": "string"
            },
            "min-zoom-field": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "opacity": {
              "type": "number",
              "format": "float"
            },
            "opacity-jitter": {
              "type": "number",
              "format": "float",
              "default": 0.0
            },
            "paint": {
              "type": "number",
              "format": "float",
              "default": 1.0
            },
            "position-jitter": {
              "type": "number",
              "format": "float",
              "default": 0.8999999761581421
            },
            "radius-px": {
              "type": "number",
              "format": "float"
            },
            "size-jitter": {
              "type": "number",
              "format": "float",
              "default": 0.0
            },
            "source-layer": {
              "type": "string"
            },
            "spacing-px": {
              "type": "number",
              "format": "float"
            },
            "type": {
              "type": "string",
              "const": "fill-dabs"
            },
            "value-jitter": {
              "type": "number",
              "format": "float",
              "default": 0.0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "source-layer",
            "color",
            "opacity",
            "radius-px",
            "spacing-px"
          ]
        },
        {
          "description": "`hokusai` brush stroke along polylines.",
          "type": "object",
          "properties": {
            "brush": {
              "description": "Brush reference. `@name` = look up in the renderer's brush bank;\notherwise treated as a path to a `.myb` file.",
              "type": "string"
            },
            "color": {
              "$ref": "#/$defs/HexColor"
            },
            "dtime": {
              "type": "number",
              "format": "float",
              "default": 0.019999999552965164
            },
            "filter": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "$ref": "#/$defs/FilterMatch"
              }
            },
            "id": {
              "type": "string"
            },
            "min-zoom-field": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "opacity": {
              "description": "Optional opacity override in `[0, 1]`. Replaces the brush's\n`opaque` base value before stroking.",
              "type": [
                "number",
                "null"
              ],
              "format": "float",
              "default": null
            },
            "pressure-base": {
              "type": "number",
              "format": "float",
              "default": 0.699999988079071
            },
            "pressure-jitter": {
              "type": "number",
              "format": "float",
              "default": 0.20000000298023224
            },
            "radius-px": {
              "description": "Optional radius override in canvas pixels. Replaces the brush's\n`radius_logarithmic` base value before stroking.",
              "type": [
                "number",
                "null"
              ],
              "format": "float",
              "default": null
            },
            "source-layer": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "line"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "source-layer",
            "brush",
            "color"
          ]
        }
      ]
    }
  }
}
